APP_NAME=Drinkerito
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# O mailer 'log' escreve em nivel debug: com LOG_LEVEL=info o e-mail da
# recuperacao de senha nunca aparece em storage/logs.
LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL apenas. Boa parte das consultas usa recursos exclusivos do
# Postgres (json_agg, FILTER, unaccent) e nao roda em SQLite.
# O ambiente local sobe com:
#   docker run -d --name drinkerito-db -p 5434:5432 \
#     -e POSTGRES_PASSWORD=drinkerito -e POSTGRES_USER=drinkerito \
#     -e POSTGRES_DB=drinkerito postgres:17-alpine
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=drinkerito
DB_USERNAME=drinkerito
DB_PASSWORD=drinkerito

# No Laravel 12 a chave e CACHE_STORE; CACHE_DRIVER e ignorado.
CACHE_STORE=database
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Em producao (HTTPS) precisa ser true.
SESSION_SECURE_COOKIE=false

# MAIL_FROM_ADDRESS vazio faz a recuperacao de senha estourar 500 com
# 'An email must have a "From" header'. Nunca deixe em branco.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="nao-responda@drinkerito.test"
MAIL_FROM_NAME="${APP_NAME}"

# Chatbot e os comandos app:gerar-bebidas-ai / app:gerar-ingredientes-ai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Imagens de bebidas e ingredientes. Sem isso o upload falha.
CLOUDINARY_URL=

# Login com Google (Socialite).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
